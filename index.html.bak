<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=0.95, maximum-scale=1, user-scalable=yes">
<meta name="color-scheme" content="dark">
<meta name="theme-color" content="#0e0d0e">
<title>Further Engine — Built for All | Free FNF Engine</title>
<meta name="description" content="Further Engine is a free, open-source Psych Engine fork for Friday Night Funkin' with global leaderboards, cloud saves and native Android, Windows, Linux, macOS and iOS builds.">
<meta name="keywords" content="Further Engine, Psych Engine fork, FNF engine, Friday Night Funkin mod engine, FNF Android, FNF leaderboard, Psych Engine Türkiye">
<meta name="author" content="SametGkTe">
<link rel="canonical" href="https://further-engine.github.io/">
<meta name="robots" content="index, follow, max-image-preview:large">
<meta property="og:type" content="website">
<meta property="og:site_name" content="Further Engine">
<meta property="og:url" content="https://further-engine.github.io/">
<meta property="og:title" content="Further Engine — Built for All | Free FNF Engine">
<meta property="og:description" content="Open-source Psych Engine fork with global leaderboards, cloud saves and builds for Android, Windows, Linux, macOS and iOS.">
<meta property="og:image" content="assets/img/icon.png">
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" href="assets/img/icon.png" sizes="any">
<link rel="apple-touch-icon" href="assets/img/icon.png">
<meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https:; connect-src 'self' https://ubhglndbbzidunjgnpqi.supabase.co https://api.github.com https://raw.githubusercontent.com; form-action 'self'; base-uri 'self'">
<meta name="referrer" content="strict-origin-when-cross-origin">
<link rel="stylesheet" href="assets/css/app.css">
<link rel="stylesheet" href="assets/css/icons.css">
<link rel="stylesheet" href="assets/css/sniro.css">
<style>
  /* hide mobile toggle on desktop, show on narrow */
  #mobile-nav-toggle{display:none}
  @media(max-width:900px){
    .BarMenuItems{display:none!important}
    #mobile-nav-toggle{display:flex!important}
  }
  @media(min-width:901px){
    #mobile-nav{display:none!important}
  }
</style>
</head>
<body>
<a href="#main" class="skip-link" style="position:absolute;left:-999px">Skip to content</a>

<!-- ===== TOP BAR — sniro style ===== -->
<div class="Bar" role="banner">
  <div class="BarContent">
    <a href="#/" class="BarLogo" aria-label="Further Engine home" style="text-decoration:none">
      <img src="assets/img/icon.png" alt="" width="34" height="34">
      <span class="BarLogo-text"><span class="fe1">FURTHER</span><span class="fe2">ENGINE</span></span>
      <span class="BarLogo-badge" data-latest-version>v1.7.0</span>
    </a>

    <nav class="BarMenuItems" aria-label="Main">
      <a href="#/" data-nav="home" class="nav-active"><i class="fa-solid fa-home" aria-hidden="true"></i> HOME</a>
      <a href="#/download" data-nav="download"><i class="fa-solid fa-download" aria-hidden="true"></i> DOWNLOAD</a>
      <a href="#/modpacks" data-nav="modpacks"><i class="fa-solid fa-cubes" aria-hidden="true"></i> MODPACKS</a>
      <a href="#/leaderboard" data-nav="online"><i class="fa-solid fa-trophy" aria-hidden="true"></i> LEADERBOARD</a>
      <a href="#/faq" data-nav="faq"><i class="fa-solid fa-circle-question" aria-hidden="true"></i> FAQ</a>
      <a href="#/credits" data-nav="credits"><i class="fa-solid fa-users" aria-hidden="true"></i> CREDITS</a>
      <a href="#/admin" id="nav-admin" class="hidden" data-nav="admin" style="color:#c4b5fd"><i class="fa-solid fa-shield-halved" aria-hidden="true"></i> ADMIN</a>
    </nav>

    <div id="BarProfile" style="margin-left:auto; display:flex; align-items:center; gap:8px">
      <div id="nav-auth-area" class="flex items-center gap-2">
        <button onclick="openModal('login')" class="FunkinButton" style="padding:7px 12px; font-size:12px; border-radius:8px">Sign in</button>
        <button onclick="openModal('register')" class="FunkinButton white" style="padding:7px 12px; font-size:12px; border-radius:8px">Register</button>
      </div>
      <button onclick="toggleMobileNav()" id="mobile-nav-toggle" aria-label="Open menu" aria-controls="mobile-nav" aria-expanded="false" class="FunkinButton" style="width:38px; height:38px; padding:0; display:flex; align-items:center; justify-content:center; border-radius:8px">
        <i class="fa-solid fa-bars" aria-hidden="true"></i>
      </button>
    </div>
  </div>
</div>

<!-- MOBILE NAV (hidden overlay, JS toggles) -->
<div id="mobile-nav" class="hidden fixed inset-0 z-[60] bg-[#0e0d0e] md:hidden pt-[56px]" style="background:rgba(14,13,14,.98); backdrop-filter:blur(10px); border-top:1px solid rgba(255,255,255,.06)">
  <div class="px-4 py-3 flex flex-col" style="max-width:800px; margin:0 auto">
    <a href="#/" data-nav="home" onclick="closeMobileNav()" class="py-3 px-2 text-[15px] flex items-center gap-3" style="font-family:'VCR OSD Mono', monospace; border-bottom:1px solid rgba(255,255,255,.06)"><i class="fa-solid fa-home w-5 text-violet-300"></i> HOME</a>
    <a href="#/download" data-nav="download" onclick="closeMobileNav()" class="py-3 px-2 text-[15px] flex items-center gap-3" style="font-family:'VCR OSD Mono', monospace; border-bottom:1px solid rgba(255,255,255,.06)"><i class="fa-solid fa-download w-5 text-violet-300"></i> DOWNLOAD</a>
    <a href="#/modpacks" data-nav="modpacks" onclick="closeMobileNav()" class="py-3 px-2 text-[15px] flex items-center gap-3" style="font-family:'VCR OSD Mono', monospace; border-bottom:1px solid rgba(255,255,255,.06)"><i class="fa-solid fa-cubes w-5 text-violet-300"></i> MODPACKS</a>
    <a href="#/leaderboard" data-nav="online" onclick="closeMobileNav()" class="py-3 px-2 text-[15px] flex items-center gap-3" style="font-family:'VCR OSD Mono', monospace; border-bottom:1px solid rgba(255,255,255,.06)"><i class="fa-solid fa-trophy w-5 text-violet-300"></i> LEADERBOARD</a>
    <a href="#/faq" data-nav="faq" onclick="closeMobileNav()" class="py-3 px-2 text-[15px] flex items-center gap-3" style="font-family:'VCR OSD Mono', monospace; border-bottom:1px solid rgba(255,255,255,.06)"><i class="fa-solid fa-circle-question w-5 text-violet-300"></i> FAQ</a>
    <a href="#/credits" data-nav="credits" onclick="closeMobileNav()" class="py-3 px-2 text-[15px] flex items-center gap-3" style="font-family:'VCR OSD Mono', monospace; border-bottom:1px solid rgba(255,255,255,.06)"><i class="fa-solid fa-users w-5 text-violet-300"></i> CREDITS</a>
    <a href="#/admin" id="nav-admin-mobile" data-nav="admin" onclick="closeMobileNav()" class="py-3 px-2 text-[15px] hidden items-center gap-3" style="font-family:'VCR OSD Mono', monospace; color:#c4b5fd; border-bottom:1px solid rgba(255,255,255,.06)"><i class="fa-solid fa-shield-halved w-5"></i> ADMIN</a>
    <div class="my-2 border-t border-white/10"></div>
    <div id="mobile-auth-area" class="flex flex-col gap-2 px-1"></div>
  </div>
</div>

<!-- USER MENU -->
<div id="user-menu" class="hidden absolute z-[70] right-4 top-[62px] w-64 glass border border-white/10 rounded-2xl shadow-2xl overflow-hidden text-sm" style="position:fixed">
  <div id="um-banner" class="h-[52px] w-full relative overflow-hidden" style="background:linear-gradient(135deg,#4c1d95,#1e1b4b); background-size:cover; background-position:center"></div>
  <div class="px-4 py-3 border-b border-white/10 -mt-1 relative z-10" style="background:#282c34">
    <div class="flex items-center gap-3">
      <div id="um-big-av" class="w-9 h-9 flex-shrink-0 rounded-xl bg-[#1e1b4b] flex items-center justify-center text-white font-bold text-sm overflow-hidden border border-white/20"></div>
      <div>
        <div id="um-name" class="font-semibold text-sm" style="font-family:'VCR OSD Mono', monospace"></div>
        <div id="um-email" class="text-xs text-slate-400" style="font-family:Inter,sans-serif"></div>
      </div>
    </div>
  </div>
  <div class="py-1" style="background:#282c34">
    <div onclick="showPage('online'); closeUserMenu()" class="flex items-center gap-3 px-4 py-2.5 hover:bg-white/5 cursor-pointer text-sm"><i class="fa-solid fa-trophy w-4 text-violet-300"></i><span>Leaderboard</span></div>
    <div onclick="openProfileSettings(); closeUserMenu()" class="flex items-center gap-3 px-4 py-2.5 hover:bg-white/5 cursor-pointer text-sm"><i class="fa-solid fa-cog w-4 text-violet-300"></i><span>Profile settings</span></div>
    <div onclick="signOut(); closeUserMenu()" class="flex items-center gap-3 px-4 py-2.5 text-red-300 hover:bg-white/5 cursor-pointer text-sm"><i class="fa-solid fa-sign-out-alt w-4"></i><span>Sign out</span></div>
  </div>
</div>

<!-- AUTH MODAL -->
<div id="modal-overlay" onclick="closeModalOutside(event)" class="hidden fixed inset-0 bg-black/70 z-[80] flex items-center justify-center" style="backdrop-filter:blur(6px)">
  <div onclick="event.stopImmediatePropagation()" class="w-full max-w-[380px] mx-4 glass border border-white/10 rounded-2xl shadow-2xl" style="background:#282c34">
    <div class="px-6 pt-6 pb-5">
      <div class="flex rounded-xl p-1 bg-[#1a1d24] mb-6 border border-white/10">
        <button onclick="switchTab('login')" id="mtab-login" class="flex-1 py-2.5 px-4 text-sm font-semibold transition-all rounded-lg bg-white/10 text-white" style="font-family:'VCR OSD Mono', monospace">Sign in</button>
        <button onclick="switchTab('register')" id="mtab-reg" class="flex-1 py-2.5 px-4 text-sm font-semibold transition-all text-slate-400 rounded-lg" style="font-family:'VCR OSD Mono', monospace">Register</button>
      </div>
      <div id="mform-login">
        <div class="mb-1">
          <h2 class="text-xl font-semibold tracking-tight" style="font-family:'VCR OSD Mono', monospace; text-align:left">Welcome back</h2>
          <p class="text-sm text-slate-400 mt-1" style="font-family:Inter,sans-serif; text-align:left">Sign in to your Further Engine account</p>
        </div>
        <div class="space-y-4 mt-5">
          <div>
            <label class="block text-xs font-semibold text-slate-400 tracking-wider mb-1.5">EMAIL</label>
            <input id="l-user" type="email" placeholder="you@example.com" autocomplete="email" class="clean-input w-full rounded-xl px-4 py-3 text-sm">
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-400 tracking-wider mb-1.5">PASSWORD</label>
            <input id="l-pass" type="password" placeholder="••••••••" class="clean-input w-full rounded-xl px-4 py-3 text-sm">
          </div>
        </div>
        <div class="mt-3">
          <div id="l-err" class="text-red-400 text-xs min-h-[16px] mb-2" style="font-family:Inter,sans-serif"></div>
          <button onclick="doLogin()" id="l-btn" class="w-full bg-white text-[#0e0d0e] font-bold py-3 rounded-xl text-sm" style="font-family:'VCR OSD Mono', monospace">SIGN IN</button>
          <button onclick="doForgot()" class="text-xs w-full text-center mt-3 text-slate-400 hover:text-violet-300" style="font-family:Inter,sans-serif">Forgot password?</button>
        </div>
      </div>
      <div id="mform-reg" class="hidden">
        <div class="mb-1">
          <h2 class="text-xl font-semibold tracking-tight" style="font-family:'VCR OSD Mono', monospace; text-align:left">Create account</h2>
          <p class="text-sm text-slate-400 mt-1" style="font-family:Inter,sans-serif; text-align:left">Join the Further Engine community</p>
        </div>
        <div class="space-y-3 mt-5">
          <div>
            <label class="block text-xs font-semibold text-slate-400 tracking-wider mb-1.5">USERNAME</label>
            <input id="r-user" type="text" maxlength="20" placeholder="your_username" class="clean-input w-full rounded-xl px-4 py-3 text-sm">
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-400 tracking-wider mb-1.5">EMAIL</label>
            <input id="r-email" type="email" placeholder="you@email.com" class="clean-input w-full rounded-xl px-4 py-3 text-sm">
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-xs font-semibold text-slate-400 tracking-wider mb-1.5">PASSWORD</label>
              <input id="r-pass" type="password" placeholder="••••••••" class="clean-input w-full rounded-xl px-4 py-3 text-sm">
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-400 tracking-wider mb-1.5">COUNTRY</label>
              <select id="r-country" class="clean-input w-full rounded-xl px-3 py-3 text-sm"></select>
            </div>
          </div>
        </div>
        <div class="mt-2">
          <div id="r-err" class="text-red-400 text-xs min-h-[16px]" style="font-family:Inter,sans-serif"></div>
          <div id="r-ok" class="text-emerald-400 text-xs min-h-[16px] mb-1" style="font-family:Inter,sans-serif"></div>
          <button onclick="doRegister()" id="r-btn" class="w-full bg-white text-[#0e0d0e] font-bold py-3 rounded-xl text-sm" style="font-family:'VCR OSD Mono', monospace">CREATE ACCOUNT</button>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- PROFILE SETTINGS MODAL -->
<div id="profile-modal-overlay" onclick="closeProfileOutside(event)" class="hidden fixed inset-0 bg-black/70 z-[80] flex items-center justify-center" style="backdrop-filter:blur(6px)">
  <div onclick="event.stopImmediatePropagation()" class="w-full max-w-lg mx-4 glass border border-white/10 rounded-2xl overflow-hidden max-h-[92vh] overflow-y-auto" style="background:#282c34">
    <div class="px-6 py-5">
      <div class="flex justify-between items-center mb-5">
        <div>
          <h3 class="text-xl font-semibold" style="font-family:'VCR OSD Mono', monospace; text-align:left">Profile Settings</h3>
          <p class="text-xs text-slate-400" style="font-family:Inter,sans-serif; text-align:left">Manage your public profile</p>
        </div>
        <button onclick="closeProfileSettings()" class="text-2xl leading-none text-slate-400 hover:text-white">×</button>
      </div>
      <div class="flex items-start gap-5">
        <div>
          <div onclick="document.getElementById('avatar-file-input').click()" class="w-[82px] h-[82px] rounded-[22px] border border-white/10 overflow-hidden cursor-pointer bg-[#1a1d24] flex items-center justify-center relative" id="ps-av-preview">
            <span id="ps-av-initials" class="text-3xl font-bold text-violet-300" style="font-family:'VCR OSD Mono', monospace"></span>
            <div class="absolute inset-0 bg-black/40 flex items-center justify-center opacity-0 hover:opacity-100 transition-all"><i class="fa-solid fa-camera text-white text-xl"></i></div>
          </div>
          <div class="flex gap-1 mt-3">
            <button onclick="document.getElementById('avatar-file-input').click()" class="text-xs px-3 py-1.5 border border-white/10 rounded-xl hover:bg-white/5 flex-1" style="font-family:'VCR OSD Mono', monospace">Upload</button>
            <button onclick="removeAvatar()" id="ps-remove-av-btn" class="text-xs px-3 py-1.5 border border-red-900/30 text-red-400 hover:bg-red-900/10 rounded-xl hidden flex-1" style="font-family:'VCR OSD Mono', monospace">Remove</button>
          </div>
        </div>
        <div class="flex-1 pt-1">
          <div class="text-xs font-semibold text-slate-400 mb-1">PROFILE PICTURE</div>
          <div class="text-[11px] text-slate-400 leading-tight" style="font-family:Inter,sans-serif">PNG, JPG, GIF or WEBP<br>Max 2MB</div>
          <div class="mt-3" id="av-progress-wrap" style="display:none"><div class="h-1.5 bg-white/10 rounded-full overflow-hidden"><div class="h-1.5 bg-violet-500 transition-all" id="av-progress-bar" style="width:0%"></div></div></div>
          <div id="av-upload-msg" class="text-xs mt-1.5" style="font-family:Inter,sans-serif"></div>
        </div>
      </div>
      <input type="file" id="avatar-file-input" accept="image/png,image/jpeg,image/gif,image/webp" class="hidden" onchange="handleAvatarFile(event)">
      <input type="file" id="banner-file-input" accept="image/png,image/jpeg,image/webp" class="hidden" onchange="handleBannerFile(event)">
      <div class="mt-6">
        <label class="text-xs font-semibold text-slate-400 tracking-wider mb-1.5 block">USERNAME</label>
        <div class="flex gap-2">
          <input id="ps-username" type="text" maxlength="20" placeholder="username" class="clean-input flex-1 rounded-xl px-4 py-2.5 text-sm" oninput="onUsernameInput()">
          <button onclick="checkUsernameAvail()" class="px-4 flex-shrink-0 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 flex items-center text-sm"><i class="fa-solid fa-magnifying-glass"></i></button>
        </div>
        <div id="ps-username-hint" class="text-xs text-slate-400 mt-1.5" style="font-family:Inter,sans-serif">Min 4 characters — letters, numbers, underscores only</div>
      </div>
      <div class="mt-4">
        <label class="text-xs font-semibold text-slate-400 tracking-wider mb-1.5 block">COUNTRY</label>
        <select id="ps-country" class="clean-input w-full rounded-xl px-4 py-2.5 text-sm"></select>
      </div>
      <div class="mt-6">
        <label class="text-xs font-semibold text-slate-400 tracking-wider mb-1.5 block">PROFILE BANNER</label>
        <div onclick="document.getElementById('banner-file-input').click()" class="relative w-full h-[92px] rounded-xl border border-white/10 bg-[#1a1d24] overflow-hidden cursor-pointer group flex items-center justify-center" id="ps-banner-preview">
          <div class="absolute inset-0 bg-gradient-to-b from-black/10 to-black/30"></div>
          <div id="ps-banner-content" class="relative z-10 text-center">
            <i class="fa-solid fa-image text-slate-400 text-xl mb-1"></i>
            <div class="text-[11px] text-slate-400" style="font-family:Inter,sans-serif">Click to upload banner (recommended 1200×300)</div>
          </div>
          <div class="absolute inset-0 bg-black/60 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-all"><div class="text-xs font-semibold px-3 py-1 bg-white/90 text-black rounded-xl" style="font-family:'VCR OSD Mono', monospace">Change Banner</div></div>
        </div>
        <div class="flex gap-2 mt-2">
          <button onclick="document.getElementById('banner-file-input').click()" class="text-xs flex-1 px-3 py-1.5 border border-white/10 rounded-xl hover:bg-white/5 flex items-center justify-center gap-1" style="font-family:'VCR OSD Mono', monospace"><i class="fa-solid fa-upload text-xs"></i> Upload Banner</button>
          <button onclick="removeBanner()" id="ps-remove-banner-btn" class="text-xs flex-1 px-3 py-1.5 border border-red-900/30 text-red-400 hover:bg-red-900/10 rounded-xl hidden" style="font-family:'VCR OSD Mono', monospace">Remove</button>
        </div>
        <div id="banner-upload-msg" class="text-xs mt-1.5" style="font-family:Inter,sans-serif"></div>
        <div class="mt-4">
          <div class="text-[10px] text-slate-400 mb-1.5 font-semibold">PREVIEW (how it will look)</div>
          <div class="rounded-xl overflow-hidden border border-white/10" style="background:#0f0f14">
            <div id="preview-banner" class="h-20 w-full flex items-end justify-end p-2 text-right" style="background:linear-gradient(135deg,#4c1d95,#1e1b4b); background-size:cover; background-position:center"><div class="text-[9px] px-2 py-0.5 bg-black/50 rounded text-white" style="font-family:'VCR OSD Mono', monospace">Banner</div></div>
            <div class="px-3 py-2 flex items-center gap-3">
              <div id="preview-avatar" class="w-9 h-9 rounded-xl bg-violet-700 flex-shrink-0 flex items-center justify-center text-sm font-bold overflow-hidden border border-white/20"></div>
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2">
                  <div id="preview-username" class="font-semibold text-sm" style="font-family:'VCR OSD Mono', monospace"></div>
                  <div id="preview-country" class="text-sm"></div>
                </div>
                <div class="text-[10px] text-violet-300" style="font-family:'VCR OSD Mono', monospace">Rank: #42 • Lv.12</div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="mt-7">
        <button onclick="saveProfile()" id="ps-save-btn" class="w-full py-3 bg-white text-[#0e0d0e] font-extrabold text-sm rounded-xl" style="font-family:'VCR OSD Mono', monospace">SAVE CHANGES</button>
        <div id="ps-msg" class="text-xs text-center h-4 mt-3" style="font-family:Inter,sans-serif"></div>
        <div class="text-[10px] text-center text-slate-500 mt-2" style="font-family:Inter,sans-serif">Banner will be shown on your profile and user menu</div>
      </div>
    </div>
  </div>
</div>

<!-- ===== MAIN APP ===== -->
<div class="App" id="main">

  <!-- STATUS BAR -->
  <div id="site-status-bar" class="hidden" role="alert" aria-live="polite" style="max-width:800px; margin:0 auto 14px auto; border-radius:14px; overflow:hidden">
    <div style="display:flex; align-items:center; justify-content:center; gap:8px; padding:10px 14px">
      <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i>
      <span id="site-status-title" class="font-bold"></span>
      <span id="site-status-message"></span>
    </div>
  </div>

  <!-- ========== HOME ========== -->
  <div id="page-home" class="page active">
    <!-- HERO -->
    <div class="RoundedContents">
      <div class="Item" style="text-align:center; padding-top:28px">
        <div style="display:inline-flex; align-items:center; gap:8px; padding:5px 12px; border-radius:999px; background:rgba(139,92,246,.12); border:1px solid rgba(139,92,246,.25); margin-bottom:14px">
          <span style="width:8px; height:8px; background:#34d399; border-radius:50%; display:inline-block; animation:blink 1.6s infinite"></span>
          <span style="font-family:'VCR OSD Mono', monospace; font-size:11px; letter-spacing:.8px; color:#6ee7b7">OPEN SOURCE • FREE FOREVER</span>
        </div>
        <div style="display:flex; flex-direction:column; align-items:center; gap:8px; margin-bottom:6px">
          <img src="assets/img/icon.png" alt="Further Engine" width="84" height="84" class="hero-logo" style="width:84px; height:84px; border-radius:18px">
          <h1 class="title-gradient-fe">FURTHER ENGINE</h1>
          <img src="assets/img/wordmark.png" alt="" width="420" style="max-width:70%; height:auto; image-rendering:auto; margin-top:4px; display:none" id="wordmark-fallback">
        </div>
        <p style="margin:10px auto 0 auto; max-width:520px; color:#b8b5c8; font-size:14px; line-height:1.6; font-family:Inter,sans-serif">Built for All. The next-generation Psych Engine fork with more customization and features.</p>

