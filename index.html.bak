  <!-- ========== MODPACKS ========== -->
  <div id="page-modpacks" class="page">
    <div class="RoundedContents">
      <div class="Item" style="text-align:center">
        <div style="display:inline-flex; align-items:center; gap:6px; padding:4px 10px; border-radius:999px; background:rgba(168,85,247,.12); border:1px solid rgba(168,85,247,.25); margin-bottom:10px">
          <span style="font-family:'VCR OSD Mono', monospace; font-size:11px; color:#d8b4fe">MODPACKS • LIVE</span>
        </div>
        <h2>Official Modpacks</h2>
        <p style="color:#9aa0b6; margin-top:6px; max-width:600px; margin-left:auto; margin-right:auto">Curated collections you can install right inside Further Engine. The list below is live from <a href="https://github.com/SametGkTe/Funky-Further-Engine/blob/main/updates/modpacks.json" target="_blank" rel="noopener" style="color:#c4b5fd">updates/modpacks.json</a> — update the JSON and the site updates automatically. In-game you get the same packs via the Modpack Browser.</p>
        <div class="filter-bar" style="margin-top:14px">
          <input id="mp-search" type="search" placeholder="Search modpacks…" oninput="filterModpacks()" style="background:#1a1d24; border:1px solid rgba(255,255,255,.12); color:#fff; padding:9px 12px; border-radius:10px; font-size:13px; width:220px; font-family:Inter,sans-serif">
          <select id="mp-tier" onchange="filterModpacks()" style="background:#1a1d24; border:1px solid rgba(255,255,255,.12); color:#fff; padding:9px 10px; border-radius:10px; font-size:12px; font-family:'VCR OSD Mono', monospace">
            <option value="all">All tiers</option>
            <option value="lite">Lite</option>
            <option value="medium">Medium</option>
            <option value="further">Further</option>
          </select>
          <button onclick="loadModpacks(true)" class="FunkinButton" style="padding:8px 12px; border-radius:10px; font-size:12px"><i class="fa-solid fa-rotate"></i> Refresh</button>
        </div>
        <div id="mp-tiers" style="display:flex; flex-wrap:wrap; justify-content:center; gap:8px; margin-top:10px"></div>
      </div>
    </div>

    <div class="RoundedContents">
      <div class="Item">
        <div id="mp-status" style="text-align:center; padding:18px; color:#9aa0b6; font-family:'VCR OSD Mono', monospace; font-size:13px">Loading modpacks…</div>
        <div id="mp-grid" class="modpack-grid"></div>
        <div id="mp-empty" style="display:none; text-align:center; padding:24px">
          <div style="font-family:'VCR OSD Mono', monospace; color:#fff">No modpacks match your filter</div>
          <div style="font-size:12px; color:#9aa0b6; margin-top:4px; font-family:Inter,sans-serif">Try a different search or tier.</div>
        </div>
        <div style="margin-top:16px; padding:12px; border-radius:12px; background:#121418; border:1px solid rgba(255,255,255,.06); display:flex; gap:10px; align-items:center">
          <i class="fa-solid fa-circle-question" style="color:#c4b5fd"></i>
          <div style="font-size:12px; color:#9aa0b6; font-family:Inter,sans-serif; line-height:1.5"><b style="color:#fff; font-family:'VCR OSD Mono', monospace">How it works in-game:</b> Further Engine → Mods → Modpacks → pick a tier → Download / Import. GitHub & MediaFire mirrors are supported. See <a href="https://github.com/SametGkTe/Funky-Further-Engine/blob/main/docs/MODDING_TR.md" target="_blank" rel="noopener" style="color:#c4b5fd">Modding guide</a> for <code style="background:rgba(255,255,255,.06); padding:1px 5px; border-radius:4px">pack.json</code> details.</div>
        </div>
      </div>
    </div>
