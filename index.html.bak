        </div>
        <!-- podium -->
        <div id="lb-podium" style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:8px; margin-top:12px">
          <div class="podium-card-fe" id="lb-pod-2" style="order:1; margin-top:18px"><div class="rank-badge-fe rank-2-fe">2</div><div id="pod2-av" style="width:56px; height:56px; margin:0 auto 6px auto; border-radius:14px; overflow:hidden; background:#1a1d24; display:flex; align-items:center; justify-content:center">—</div><div id="pod2-name" style="font-family:'VCR OSD Mono', monospace; font-size:12px; color:#fff; white-space:nowrap; overflow:hidden; text-overflow:ellipsis">—</div><div id="pod2-meta" style="font-size:11px; color:#9aa0b6">—</div></div>
          <div class="podium-card-fe gold" id="lb-pod-1" style="order:2"><div class="rank-badge-fe rank-1-fe">1</div><div id="pod1-av" style="width:64px; height:64px; margin:0 auto 6px auto; border-radius:14px; overflow:hidden; background:#1a1d24; display:flex; align-items:center; justify-content:center; border:2px solid rgba(251,191,36,.4)">👑</div><div id="pod1-name" style="font-family:'VCR OSD Mono', monospace; font-size:13px; color:#fff; white-space:nowrap; overflow:hidden; text-overflow:ellipsis">—</div><div id="pod1-meta" style="font-size:11px; color:#9aa0b6">—</div><div id="pod1-flag" style="font-size:18px; margin-top:4px"></div><div id="pod1-score" style="font-family:'VCR OSD Mono', monospace; font-size:12px; color:#fbbf24; margin-top:2px">—</div></div>
          <div class="podium-card-fe bronze" id="lb-pod-3" style="order:3; margin-top:18px"><div class="rank-badge-fe rank-3-fe">3</div><div id="pod3-av" style="width:56px; height:56px; margin:0 auto 6px auto; border-radius:14px; overflow:hidden; background:#1a1d24; display:flex; align-items:center; justify-content:center">—</div><div id="pod3-name" style="font-family:'VCR OSD Mono', monospace; font-size:12px; color:#fff; white-space:nowrap; overflow:hidden; text-overflow:ellipsis">—</div><div id="pod3-meta" style="font-size:11px; color:#9aa0b6">—</div></div>
        </div>
      </div>
    </div>

    <div class="RoundedContents">
      <div class="Item">
        <div id="lb-country-chips" style="display:flex; flex-wrap:wrap; justify-content:center; gap:6px; margin-bottom:10px"></div>
        <div style="display:flex; flex-wrap:wrap; gap:8px; align-items:center; justify-content:center; margin-bottom:10px">
          <select id="lb-country" onchange="setLBCountry(this.value)" style="background:#1a1d24; border:1px solid rgba(255,255,255,.12); color:#fff; padding:8px 10px; border-radius:10px; font-size:12px; font-family:'VCR OSD Mono', monospace; min-width:160px"><option value="all">🌍 All countries</option></select>
          <select id="lb-sort" onchange="setLBSort(this.value)" style="background:#1a1d24; border:1px solid rgba(255,255,255,.12); color:#fff; padding:8px 10px; border-radius:10px; font-size:12px; font-family:'VCR OSD Mono', monospace">
            <option value="rank">Sort by Rank</option>
            <option value="level">Level</option>
            <option value="accuracy">Accuracy</option>
            <option value="songs">Songs played</option>
          </select>
          <div style="position:relative; flex:1; min-width:180px; max-width:260px">
            <input id="lb-search" type="search" oninput="lbSearch(this.value)" placeholder="Search players…" style="width:100%; background:#1a1d24; border:1px solid rgba(255,255,255,.12); color:#fff; padding:8px 12px 8px 34px; border-radius:10px; font-size:13px; font-family:Inter,sans-serif">
            <i class="fa-solid fa-magnifying-glass" style="position:absolute; left:10px; top:50%; transform:translateY(-50%); color:#6b7280; font-size:12px"></i>
          </div>
          <button onclick="clearLBSearch()" class="FunkinButton" style="padding:7px 12px; border-radius:10px; font-size:12px">Clear</button>
        </div>
        <div id="lb-active-filters" class="hidden" style="display:none; align-items:center; gap:8px; margin-bottom:10px; font-size:12px; color:#9aa0b6; font-family:Inter,sans-serif"><i class="fa-solid fa-filter" style="color:#c4b5fd"></i><span id="lb-active-label"></span><button onclick="clearLBFilters()" style="color:#c4b5fd; text-decoration:underline; background:none; border:none; cursor:pointer; font-family:'VCR OSD Mono', monospace; font-size:11px">Clear filters</button></div>
        <div id="lb-my-rank" class="hidden" style="display:none; align-items:center; justify-content:space-between; gap:10px; padding:10px 14px; border-radius:14px; border:1px solid rgba(139,92,246,.25); background:rgba(139,92,246,.08); margin-bottom:10px"></div>
        <div id="lb-table-top">
          <div id="lb-loading" style="padding:18px; text-align:center; color:#9aa0b6; font-family:'VCR OSD Mono', monospace">Loading leaderboard…</div>
          <div id="lb-empty" class="hidden" style="display:none; justify-content:center; padding:32px; text-align:center; color:#9aa0b6; font-size:13px; font-family:Inter,sans-serif"></div>
          <div style="overflow-x:auto; border-radius:12px; border:1px solid rgba(255,255,255,.06)">
            <table id="lb-table" class="lb-table w-full hidden" style="min-width:600px">
              <thead><tr id="lb-thead" style="text-align:left; background:#1a1d24"></tr></thead>
              <tbody id="lb-body" class="text-sm"></tbody>
            </table>
          </div>
          <div id="lb-pager" class="hidden" style="display:none; flex-direction:row; align-items:center; justify-content:space-between; gap:10px; margin-top:12px; padding-top:12px; border-top:1px solid rgba(255,255,255,.06)">
            <div id="lb-count" style="font-size:12px; color:#9aa0b6; font-family:'VCR OSD Mono', monospace"></div>
            <nav id="lb-pages" style="display:flex; align-items:center; gap:4px; flex-wrap:wrap; justify-content:center" aria-label="Pages"></nav>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ========== FAQ ========== -->
  <div id="page-faq" class="page">
    <div class="RoundedContents">
      <div class="Item">
        <div style="text-align:center; margin-bottom:12px">
          <div style="display:inline-flex; align-items:center; gap:6px; padding:4px 10px; border-radius:999px; background:rgba(59,130,246,.12); border:1px solid rgba(59,130,246,.25); margin-bottom:8px">
            <i class="fa-solid fa-circle-question" style="color:#60a5fa"></i>
            <span style="font-family:'VCR OSD Mono', monospace; font-size:11px; color:#93c5fd">SUPPORT</span>
          </div>
          <h2>Frequently Asked Questions</h2>
          <p style="color:#9aa0b6; margin-top:6px">Everything you need to know about Further Engine.</p>
        </div>
        <div id="faq-list" style="display:grid; gap:8px">
          <!-- FAQ items injected by JS or static -->
          <details class="faq-item" style="background:#1a1d24; border:1px solid rgba(255,255,255,.06); border-radius:12px; overflow:hidden">
            <summary onclick="event.preventDefault(); toggleFaq(this)" style="padding:14px 16px; cursor:pointer; display:flex; align-items:center; justify-content:space-between; gap:10px; list-style:none; font-family:'VCR OSD Mono', monospace; font-size:13px; color:#fff">What is Further Engine? <i class="fa-solid fa-chevron-down" style="color:#9aa0b6; transition:.2s"></i></summary>
            <div class="faq-answer hidden" style="padding:0 16px 14px 16px; color:#b8b5c8; font-size:13px; line-height:1.6; font-family:Inter,sans-serif">Further Engine is an enhanced, next-generation fork of Psych Engine — the popular Friday Night Funkin' mod engine. It adds powerful online features like global leaderboards, account systems, level progression, and modern optimizations on top of the core engine.</div>
          </details>
          <details class="faq-item" style="background:#1a1d24; border:1px solid rgba(255,255,255,.06); border-radius:12px; overflow:hidden">
            <summary onclick="event.preventDefault(); toggleFaq(this)" style="padding:14px 16px; cursor:pointer; display:flex; align-items:center; justify-content:space-between; gap:10px; list-style:none; font-family:'VCR OSD Mono', monospace; font-size:13px; color:#fff">What does Further Engine add over regular Psych Engine? <i class="fa-solid fa-chevron-down" style="color:#9aa0b6"></i></summary>
            <div class="faq-answer hidden" style="padding:0 16px 14px 16px; color:#b8b5c8; font-size:13px; line-height:1.6; font-family:Inter,sans-serif">Online accounts & logins (web + in-game), global real-time leaderboards, XP and level system, automatic score syncing, cross-platform profiles, optimized Android builds, and improved performance across the board.</div>
          </details>
          <details class="faq-item" style="background:#1a1d24; border:1px solid rgba(255,255,255,.06); border-radius:12px; overflow:hidden">
            <summary onclick="event.preventDefault(); toggleFaq(this)" style="padding:14px 16px; cursor:pointer; display:flex; align-items:center; justify-content:space-between; gap:10px; list-style:none; font-family:'VCR OSD Mono', monospace; font-size:13px; color:#fff">How do I create an account? <i class="fa-solid fa-chevron-down" style="color:#9aa0b6"></i></summary>
            <div class="faq-answer hidden" style="padding:0 16px 14px 16px; color:#b8b5c8; font-size:13px; line-height:1.6; font-family:Inter,sans-serif">You can register directly on this website by clicking the Register button. You can also create an account directly in-game. Once registered, the same credentials work everywhere.</div>
          </details>
          <details class="faq-item" style="background:#1a1d24; border:1px solid rgba(255,255,255,.06); border-radius:12px; overflow:hidden">
            <summary onclick="event.preventDefault(); toggleFaq(this)" style="padding:14px 16px; cursor:pointer; display:flex; align-items:center; justify-content:space-between; gap:10px; list-style:none; font-family:'VCR OSD Mono', monospace; font-size:13px; color:#fff">Is an account required to play? <i class="fa-solid fa-chevron-down" style="color:#9aa0b6"></i></summary>
            <div class="faq-answer hidden" style="padding:0 16px 14px 16px; color:#b8b5c8; font-size:13px; line-height:1.6; font-family:Inter,sans-serif">No. You can play completely offline without an account. However, you won't be able to access leaderboards or cloud features until you register. Accounts can be created anytime.</div>
          </details>
          <details class="faq-item" style="background:#1a1d24; border:1px solid rgba(255,255,255,.06); border-radius:12px; overflow:hidden">
            <summary onclick="event.preventDefault(); toggleFaq(this)" style="padding:14px 16px; cursor:pointer; display:flex; align-items:center; justify-content:space-between; gap:10px; list-style:none; font-family:'VCR OSD Mono', monospace; font-size:13px; color:#fff">How does the level system work? <i class="fa-solid fa-chevron-down" style="color:#9aa0b6"></i></summary>
            <div class="faq-answer hidden" style="padding:0 16px 14px 16px; color:#b8b5c8; font-size:13px; line-height:1.6; font-family:Inter,sans-serif">Level is calculated based on your total score across all songs. Level = √(Total Score / 1000). Only your highest score on each song/difficulty counts towards your total progress.</div>
          </details>
          <details class="faq-item" style="background:#1a1d24; border:1px solid rgba(255,255,255,.06); border-radius:12px; overflow:hidden">
            <summary onclick="event.preventDefault(); toggleFaq(this)" style="padding:14px 16px; cursor:pointer; display:flex; align-items:center; justify-content:space-between; gap:10px; list-style:none; font-family:'VCR OSD Mono', monospace; font-size:13px; color:#fff">Can I use mods with Further Engine? <i class="fa-solid fa-chevron-down" style="color:#9aa0b6"></i></summary>
            <div class="faq-answer hidden" style="padding:0 16px 14px 16px; color:#b8b5c8; font-size:13px; line-height:1.6; font-family:Inter,sans-serif">Yes! Further Engine is 100% compatible with Lua and HScript mods. Just place them in your /mods folder. Note: Online scores are only tracked for official base game songs.</div>
          </details>
          <details class="faq-item" style="background:#1a1d24; border:1px solid rgba(255,255,255,.06); border-radius:12px; overflow:hidden">
            <summary onclick="event.preventDefault(); toggleFaq(this)" style="padding:14px 16px; cursor:pointer; display:flex; align-items:center; justify-content:space-between; gap:10px; list-style:none; font-family:'VCR OSD Mono', monospace; font-size:13px; color:#fff">Which platforms are supported? <i class="fa-solid fa-chevron-down" style="color:#9aa0b6"></i></summary>
            <div class="faq-answer hidden" style="padding:0 16px 14px 16px; color:#b8b5c8; font-size:13px; line-height:1.6; font-family:Inter,sans-serif">Android, Windows, Linux, macOS (Intel and Apple Silicon) and iOS. Every platform is built from the same source and published on GitHub Releases. The project is still in beta, so mobile builds in particular may have platform-specific bugs.</div>
          </details>
          <details class="faq-item" style="background:#1a1d24; border:1px solid rgba(255,255,255,.06); border-radius:12px; overflow:hidden">
            <summary onclick="event.preventDefault(); toggleFaq(this)" style="padding:14px 16px; cursor:pointer; display:flex; align-items:center; justify-content:space-between; gap:10px; list-style:none; font-family:'VCR OSD Mono', monospace; font-size:13px; color:#fff">Is multiplayer / online rooms available? <i class="fa-solid fa-chevron-down" style="color:#9aa0b6"></i></summary>
            <div class="faq-answer hidden" style="padding:0 16px 14px 16px; color:#b8b5c8; font-size:13px; line-height:1.6; font-family:Inter,sans-serif">No. Online room creation and multiplayer features are NOT available yet. They will be added soon! The game has a login system and scores turn into UP points that go to the global leaderboard.</div>
          </details>
          <details class="faq-item" style="background:#1a1d24; border:1px solid rgba(255,255,255,.06); border-radius:12px; overflow:hidden">
            <summary onclick="event.preventDefault(); toggleFaq(this)" style="padding:14px 16px; cursor:pointer; display:flex; align-items:center; justify-content:space-between; gap:10px; list-style:none; font-family:'VCR OSD Mono', monospace; font-size:13px; color:#fff">What data does Further Engine store about me? <i class="fa-solid fa-chevron-down" style="color:#9aa0b6"></i></summary>
            <div class="faq-answer hidden" style="padding:0 16px 14px 16px; color:#b8b5c8; font-size:13px; line-height:1.6; font-family:Inter,sans-serif">Your email, username, country, avatar/banner and your scores. For fair play we also record the IP address your account signs in from — it is stored server-side, never shown to other players, used only to detect duplicate accounts, and single-account records are deleted after 90 days. Delete your account and everything goes with it.</div>
          </details>
        </div>
      </div>
    </div>
  </div>

  <!-- ========== CREDITS ========== -->
  <div id="page-credits" class="page">
    <div class="RoundedContents">
      <div class="Item" style="text-align:center">
        <div style="display:inline-flex; align-items:center; gap:6px; padding:4px 10px; border-radius:999px; background:rgba(236,72,153,.12); border:1px solid rgba(236,72,153,.25); margin-bottom:10px">
          <span style="font-family:'VCR OSD Mono', monospace; font-size:11px; color:#f9a8d4">TEAM</span>
        </div>
        <h2>Credits</h2>
        <p style="color:#9aa0b6; margin-top:4px">The people who made Further Engine possible</p>
        <div style="display:flex; justify-content:center; gap:16px; margin-top:18px; flex-wrap:wrap">
          <div style="background:#1a1d24; border:1px solid rgba(255,255,255,.08); border-radius:16px; padding:18px; width:260px; text-align:center">
            <img src="assets/img/gkte.webp" alt="SametGkTe" width="96" height="96" style="width:96px; height:96px; border-radius:16px; object-fit:cover; margin:0 auto 10px auto; display:block; border:2px solid rgba(139,92,246,.3)">
            <div style="font-family:'VCR OSD Mono', monospace; font-size:15px; color:#fff">SametGkTe</div>
            <div style="font-size:11px; letter-spacing:.6px; color:#c4b5fd; font-family:'VCR OSD Mono', monospace; margin-top:2px">CREATOR & LEAD DEVELOPER</div>
            <div style="font-size:12px; color:#9aa0b6; margin-top:6px; font-family:Inter,sans-serif">Creator of Further Engine</div>
            <div style="display:flex; justify-content:center; gap:8px; margin-top:10px">
              <a href="https://github.com/SametGkTe" target="_blank" rel="noopener" class="FunkinButton" style="padding:6px 10px; font-size:11px; border-radius:999px; text-decoration:none"><i class="fa-brands fa-github"></i> GitHub</a>
              <a href="https://linktr.ee/skysamet" target="_blank" rel="noopener" class="FunkinButton" style="padding:6px 10px; font-size:11px; border-radius:999px; text-decoration:none">Website</a>
            </div>
          </div>
        </div>
        <div style="margin-top:18px; padding:14px; border-radius:12px; background:#121418; border:1px solid rgba(255,255,255,.06)">
          <div style="font-family:'VCR OSD Mono', monospace; font-size:12px; color:#fff; margin-bottom:8px">Base Projects & Contributors</div>
          <div style="display:flex; flex-wrap:wrap; gap:6px; justify-content:center">
            <a href="https://github.com/ShadowMario/FNF-PsychEngine" target="_blank" rel="noopener" style="padding:6px 10px; border-radius:999px; background:#1a1d24; border:1px solid rgba(255,255,255,.08); color:#d8d6e2; font-size:11px; font-family:'VCR OSD Mono', monospace; text-decoration:none">Shadow Mario — Psych Engine</a>
            <span style="padding:6px 10px; border-radius:999px; background:#1a1d24; border:1px solid rgba(255,255,255,.08); color:#9aa0b6; font-size:11px; font-family:Inter,sans-serif">RiverOaken — Psych Artist</span>
            <a href="https://github.com/FunkinCrew" target="_blank" rel="noopener" style="padding:6px 10px; border-radius:999px; background:#1a1d24; border:1px solid rgba(255,255,255,.08); color:#d8d6e2; font-size:11px; font-family:'VCR OSD Mono', monospace; text-decoration:none">The Funkin' Crew — FNF</a>
          </div>
          <p style="font-size:11px; color:#6b7280; margin-top:10px; font-family:Inter,sans-serif">Further Engine is an independent community project. Not affiliated with the Psych Engine Team or Funkin' Crew.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- ========== ADMIN ========== -->
  <div id="page-admin" class="page">
    <div class="RoundedContents">
      <div class="Item" style="text-align:center">
        <div style="display:inline-flex; align-items:center; gap:6px; padding:4px 10px; border-radius:999px; background:rgba(139,92,246,.12); border:1px solid rgba(139,92,246,.25); margin-bottom:8px">
          <i class="fa-solid fa-shield-halved" style="color:#c4b5fd"></i>
          <span style="font-family:'VCR OSD Mono', monospace; font-size:11px; color:#c4b5fd">STAFF ONLY</span>
        </div>
        <h2>Moderation</h2>
        <p style="color:#9aa0b6; font-size:12px; margin-top:4px">Multi-account detection and leaderboard integrity</p>
        <div id="admin-denied" class="hidden" style="max-width:380px; margin:14px auto 0 auto; text-align:center; background:#1a1d24; border:1px solid rgba(255,255,255,.08); border-radius:14px; padding:18px">
          <i class="fa-solid fa-lock" style="font-size:28px; color:#6b7280"></i>
          <div style="font-family:'VCR OSD Mono', monospace; margin-top:8px; color:#fff">Not authorized</div>
          <p style="font-size:12px; color:#9aa0b6; margin-top:6px; font-family:Inter,sans-serif">This area is limited to staff accounts. If you believe this is a mistake, sign in with your admin account.</p>
          <a href="#/" class="FunkinButton" style="display:inline-block; margin-top:12px; padding:8px 14px; border-radius:999px; text-decoration:none; font-size:12px">Back to home</a>
        </div>
        <div id="admin-body" class="hidden" style="text-align:left; margin-top:14px">
          <div id="admin-overview" style="display:grid; grid-template-columns:repeat(4,1fr); gap:8px; margin-bottom:12px"></div>
          <div style="display:flex; justify-content:center; margin-bottom:12px">
            <div style="display:inline-flex; flex-wrap:wrap; justify-content:center; background:#1a1d24; border:1px solid rgba(255,255,255,.08); border-radius:999px; padding:3px" role="tablist">
              <button onclick="adminTab('suspects')" id="admin-tab-suspects" role="tab" aria-selected="true" class="TabButton active" style="border-radius:999px; padding:7px 14px; font-size:12px; font-family:'VCR OSD Mono', monospace"><i class="fa-solid fa-user-secret"></i> Suspects</button>
              <button onclick="adminTab('ips')" id="admin-tab-ips" role="tab" aria-selected="false" class="TabButton" style="border-radius:999px; padding:7px 14px; font-size:12px; font-family:'VCR OSD Mono', monospace"><i class="fa-solid fa-network-wired"></i> Shared IPs</button>
              <button onclick="adminTab('emails')" id="admin-tab-emails" role="tab" aria-selected="false" class="TabButton" style="border-radius:999px; padding:7px 14px; font-size:12px; font-family:'VCR OSD Mono', monospace"><i class="fa-solid fa-at"></i> Duplicate emails</button>
            </div>
          </div>
          <div style="display:flex; align-items:center; justify-content:space-between; gap:8px; margin-bottom:8px">
            <div id="admin-hint" style="font-size:11px; color:#9aa0b6; font-family:Inter,sans-serif"></div>
            <button onclick="adminRefresh()" class="FunkinButton" style="padding:7px 12px; border-radius:999px; font-size:11px; flex-shrink:0"><i class="fa-solid fa-rotate"></i> Refresh</button>
          </div>
          <div id="admin-panel" style="background:#1a1d24; border:1px solid rgba(255,255,255,.08); border-radius:14px; padding:12px; overflow-x:auto">
            <div style="text-align:center; padding:18px; color:#9aa0b6; font-family:'VCR OSD Mono', monospace; font-size:13px">Loading…</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- FOOTER -->
  <div class="RoundedContents" style="margin-top:14px">
    <div class="Item" style="padding:16px">
      <div style="display:grid; grid-template-columns:1.6fr 1fr 1fr; gap:16px">
        <div>
          <div style="display:flex; align-items:center; gap:8px">
            <img src="assets/img/icon.png" alt="" width="22" height="22" style="width:22px; height:22px; border-radius:6px">
            <span style="font-family:'VCR OSD Mono', monospace; font-size:13px; color:#fff">Further Engine</span>
          </div>
          <p style="font-size:11px; color:#9aa0b6; margin-top:8px; line-height:1.5; max-width:320px; font-family:Inter,sans-serif">A free, open-source Psych Engine fork for Friday Night Funkin', built with Haxe, OpenFL and HaxeFlixel. Also known as "Psych Engine Türkiye".</p>
        </div>
        <nav aria-label="Site" style="font-size:11px">
          <div style="font-family:'VCR OSD Mono', monospace; font-size:10px; letter-spacing:.8px; color:#c4b5fd; margin-bottom:8px">SITE</div>
          <ul style="display:grid; gap:6px; list-style:none; padding:0; margin:0">
            <li><a href="#/" style="color:#d8d6e2">Home</a></li>
            <li><a href="#/download" style="color:#d8d6e2">Download</a></li>
            <li><a href="#/modpacks" style="color:#d8d6e2">Modpacks</a></li>
            <li><a href="#/leaderboard" style="color:#d8d6e2">Leaderboard</a></li>
            <li><a href="#/faq" style="color:#d8d6e2">FAQ</a></li>
            <li><a href="#/credits" style="color:#d8d6e2">Credits</a></li>
          </ul>
        </nav>
        <nav aria-label="Project" style="font-size:11px">
          <div style="font-family:'VCR OSD Mono', monospace; font-size:10px; letter-spacing:.8px; color:#c4b5fd; margin-bottom:8px">PROJECT</div>
