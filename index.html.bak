            <div id="lb-upd" style="font-family:'VCR OSD Mono', monospace; font-size:18px; color:#fff">—</div>
            <div style="font-size:9px; letter-spacing:.6px; color:#9aa0b6; font-family:'VCR OSD Mono', monospace">LAST UPDATE</div>
